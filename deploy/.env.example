# hikvision-ingest settings. Copy to deploy/.env on the server; never commit the real file.

# The terminal(s) allowed to push. The token is the secret part of the push URL
# (https://hik.phoenix-math.uz/hikvision/<token>) — at least 24 random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# sn = the terminal's serial number (ISAPI /ISAPI/System/deviceInfo → serialNumber).
# digest_user/digest_pass: only when the terminal's HTTP Host uses MD5digest authentication.
HIK_DEVICES=[{"token":"CHANGE-ME-32-random-characters","label":"Room 1 (DS-K1T331W)","sn":"CHANGE-ME-serial","expected_ip":"192.168.0.141","success_event_codes":["153"]}]

# Where the scans go: the intranet inside the same docker network (no TLS hop needed),
# and the intranet's HIKVISION_INTEGRATION_KEY (the same value on both sides, 16+ characters).
ERP_URL=http://app:5000
ERP_KEY=CHANGE-ME

# Pilot only: a neutral Telegram notice for each fresh pass (who, when, where). Leave empty to turn off.
# Use a NEW bot token — the one in webhook_server.py is in plain text in the source and must be revoked.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Optional tuning (defaults shown)
# HIK_INGEST_DB=/data/hikvision-ingest.db
# MAX_FUTURE_SKEW_SECONDS=600
# TELEGRAM_MAX_AGE_SECONDS=120
# RAW_RETENTION_DAYS=14
# FORWARD_BATCH=100   (at most 300)
# FORWARD_INTERVAL_SECONDS=5
# HIK_NONCE_SECRET=   (only with digest; random, keeps nonces valid across restarts)
